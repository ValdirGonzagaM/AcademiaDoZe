<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfiguracoesPage" Title="Configurações">
 <ScrollView><VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="900">
  <Label Text="Do seu jeito" FontSize="28" FontAttributes="Bold" />
  <Label Text="Personalize sua experiência na academia." />
  <Border Padding="20"><VerticalStackLayout Spacing="12">
   <Label Text="Idioma" FontSize="20" FontAttributes="Bold" />
   <Picker x:Name="IdiomaPicker" Title="Idioma" SelectedIndexChanged="IdiomaChanged">
    <Picker.Items><x:String>Português (Brasil)</x:String><x:String>English (US)</x:String><x:String>Español (España)</x:String></Picker.Items>
   </Picker>
   <Label Text="A alteração é aplicada imediatamente e salva neste dispositivo." FontSize="13" />
  </VerticalStackLayout></Border>
  <Border Padding="20"><VerticalStackLayout Spacing="12">
   <Label Text="Aparência" FontSize="20" FontAttributes="Bold" />
   <Button Text="Claro" Clicked="TemaClaro" /><Button Text="Escuro" Clicked="TemaEscuro" /><Button Text="Sistema" Clicked="TemaSistema" />
  </VerticalStackLayout></Border>
  <Border Padding="20"><VerticalStackLayout Spacing="8">
   <Label Text="Armazenamento" FontSize="20" FontAttributes="Bold" />
   <Label Text="SQLite local — seus cadastros são mantidos neste dispositivo." />
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
