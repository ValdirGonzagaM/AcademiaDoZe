<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AcademiaDoZe.Presentation.AppMaui"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé">

    <FlyoutItem Title="Início">
        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Colaboradores">
        <ShellContent Title="Colaboradores" ContentTemplate="{DataTemplate views:ColaboradorListPage}" Route="ColaboradorListPage" />
    </FlyoutItem>
    <FlyoutItem Title="Alunos">
        <ShellContent Title="Alunos" ContentTemplate="{DataTemplate views:AlunoListPage}" Route="AlunoListPage" />
    </FlyoutItem>
    <FlyoutItem Title="Logradouros">
        <ShellContent
            Title="Logradouros"
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="LogradouroListPage" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações">
        <ShellContent
            Title="Configurações"
            ContentTemplate="{DataTemplate views:ConfiguracoesPage}"
            Route="ConfiguracoesPage" />
    </FlyoutItem>

</Shell>