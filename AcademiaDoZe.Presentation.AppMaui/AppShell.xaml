<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AcademiaDoZe.Presentation.AppMaui"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé">

    <FlyoutItem Title="Início" Icon="icon_dashboard.png">
        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Logradouros" Icon="icon_logradouro.png">
        <ShellContent
            Title="Logradouros"
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="LogradouroListPage" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações" Icon="icon_settings.png">
        <ShellContent
            Title="Configurações"
            ContentTemplate="{DataTemplate views:ConfiguracoesPage}"
            Route="ConfiguracoesPage" />
    </FlyoutItem>

</Shell>