<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.MainPage" Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Border BackgroundColor="#143D3B" StrokeShape="RoundRectangle 24" Padding="24">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MOVIMENTO · CUIDADO · COMUNIDADE" FontSize="11" TextColor="#F0BD67" />
                    <Image Source="logo_aluno.png" HeightRequest="170" Aspect="AspectFit"
                           SemanticProperties.Description="Logotipo da Academia do Zé por Valdir Gonzaga" />
                    <Label Text="Academia do Zé" FontSize="30" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Valdir Gonzaga" FontSize="18" TextColor="#F0BD67" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Sua academia, mais próxima das pessoas." FontSize="22" FontAttributes="Bold" />
            <Label Text="Gerencie a equipe e os alunos com cadastros completos e fotos." />
            <Button Text="Gerenciar colaboradores →" Clicked="OnColaboradoresClicked" />
            <Button Text="Gerenciar alunos →" Clicked="OnAlunosClicked" />
            <Border Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Comece pelo endereço" FontAttributes="Bold" />
                    <Label Text="Cadastre um logradouro e depois vincule os alunos e colaboradores." />
                    <Button Text="Abrir logradouros" Clicked="OnLogradourosClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
